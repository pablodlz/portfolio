---
import Sec from './Sec.astro';
import Icon from '../ui/Icon.astro';
import { data, obfuscatedEmail } from '../../lib/data';
import { withBase } from '../../lib/url';
import { GUARANTEES, AUTHORIZED_USE, OMNI_VERSION, OMNI_SNAPSHOT } from '../../lib/omni';

const mail = obfuscatedEmail();
const { profile } = data;
---

<Sec
  n="11"
  id="garantias"
  title="Quatro garantias que não dependem do bom comportamento do modelo"
  lede="Toda a autonomia acima existe dentro destes quatro limites — e nenhum deles é uma instrução ao modelo: são decisões de código determinístico e de gente."
>
  <dl class="clauses">
    {GUARANTEES.map((g) => (
      <div class="clause">
        <dt>{g.title}</dt>
        <dd>{g.what}</dd>
      </div>
    ))}
  </dl>

  <p class="warn">
    <span class="warn-k">Uso autorizado apenas</span>
    <span class="warn-v" set:html={AUTHORIZED_USE} />
  </p>
</Sec>

<section id="contato" class="close">
  <div class="container close-grid">
    <div class="close-mark" aria-hidden="true">
      <span class="close-rule"></span>
      <span class="o-label">fim do dossiê</span>
      <span class="close-rule"></span>
    </div>

    <div class="close-main">
      <h2 class="close-t">O código é fechado. A conversa não.</h2>
      <p class="close-d">
        O Omni Pentest é um projeto pessoal de pesquisa aplicada em segurança ofensiva e IA, de
        <b>{profile.fullName}</b>. Dúvidas sobre arquitetura, sobre os resultados ou um pedido de
        demonstração são bem-vindos.
      </p>

      <ul class="close-links">
        <li>
          <a class="js-mail" href="#contato" data-u={mail.u} data-d={mail.d}>
            <Icon name="mail" size={16} />
            <span class="js-mail-addr">Enviar e-mail</span>
          </a>
        </li>
        <li>
          <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={16} />
            LinkedIn
          </a>
        </li>
        <li>
          <a href={withBase('/')}>
            <Icon name="arrow-right" size={16} />
            Voltar ao portfólio
          </a>
        </li>
      </ul>

      <noscript>
        <p class="close-noscript">e-mail: pablogalerani [arroba] gmail [ponto] com</p>
      </noscript>
    </div>

    <aside class="stamp">
      <p class="o-label o-label--accent">Nota de honestidade</p>
      <p class="stamp-d">
        Esta página retrata a versão <b>{OMNI_VERSION}</b>, de <b>{OMNI_SNAPSHOT}</b>. A plataforma
        segue em desenvolvimento ativo e evolui mais rápido do que este dossiê — o que você leu é o
        retrato daquele momento, não necessariamente o estado atual.
      </p>
    </aside>
  </div>
</section>

<style>
  /* --- garantias: ficha de cláusulas (chave grande à esquerda) --- */
  .clauses {
    margin-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
  }
  .clause {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .clause dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--accent);
    line-height: 1.35;
  }
  .clause dd {
    max-width: 62ch;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }

  /* o aviso que abre o repositório — mesma altitude, sem alarde */
  .warn {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--accent-border);
    border-radius: var(--radius-sm);
  }
  .warn-k {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .warn-v {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .warn-v :global(b) {
    color: var(--text);
    font-weight: 600;
  }

  /* --- fecho --- */
  .close {
    padding-block: var(--space-7) var(--space-8);
  }
  .close-mark {
    display: grid;
    grid-template-columns: var(--space-6) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .close-rule {
    height: 1px;
    background: var(--border-strong);
  }

  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .close-mark {
    grid-column: 1 / -1;
  }

  .close-t {
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }
  .close-d {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.8;
  }
  .close-d b {
    color: var(--text);
    font-weight: 600;
  }

  .close-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
    list-style: none;
  }
  .close-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: border-color var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
  }
  .close-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .close-links li:first-child a {
    border-color: var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .close-noscript {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  .stamp {
    padding: var(--space-5);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .stamp-d {
    margin-top: var(--space-3);
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.85;
  }
  .stamp-d b {
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .close-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 720px) {
    .clause,
    .warn {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
