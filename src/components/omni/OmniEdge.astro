---
import Sec from './Sec.astro';
import { CAPABILITIES } from '../../lib/omni';

/** O eixo vem primeiro e ocupa a linha inteira; o resto é ficha de motores. */
const axis = CAPABILITIES.filter((c) => c.tag === 'o eixo');
const rest = CAPABILITIES.filter((c) => c.tag !== 'o eixo');
---

<Sec
  n="03"
  id="metodo"
  title="Gerar-e-testar é raso. Modelar-e-deduzir, não."
  lede="A indústria de pentest com IA opera num único paradigma: inventa um payload, dispara, observa, segue. É empírico e ganancioso — e por isso não enxerga a classe de bug que mais paga."
>
  <div class="split">
    <div class="split-side">
      <p class="o-label">A IA faz</p>
      <p>o que é criativo e impreciso — a abstração, as hipóteses, as regras que o produto deveria cumprir.</p>
    </div>
    <div class="split-side">
      <p class="o-label o-label--accent">O código faz</p>
      <p>o que é rigoroso e verificável — aprender a máquina de estados, resolver as restrições, verificar as propriedades e julgar o achado.</p>
    </div>
  </div>

  {axis.map((c) => (
    <article class="axis">
      <p class="o-label o-label--accent">{c.tag}</p>
      <h3 class="axis-t">{c.name}</h3>
      <p class="axis-d">{c.what}</p>
    </article>
  ))}

  <p class="o-label motors-label">Os outros motores</p>
  <div class="o-rows">
    {rest.map((c) => (
      <div class="o-row">
        <div class="o-row-k">{c.tag}</div>
        <div class="o-row-v">
          <span class="o-row-t">{c.name}</span>
          {c.what}
        </div>
      </div>
    ))}
  </div>

  <p class="o-note">
    Cada motor apenas <b>propõe</b> um candidato melhor — o firewall segue sendo o único juiz. E tudo
    isso roda em <b>CPU comum, sem placa de vídeo</b>: a inteligência mora em álgebra e lógica, não em
    computação pesada.
  </p>
</Sec>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }
  .split-side {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }
  .split-side + .split-side {
    padding-left: var(--space-5);
    border-left: 1px solid var(--border);
  }
  .split-side p + p {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.75;
  }

  .axis {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--accent-border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .axis-t {
    margin-top: var(--space-2);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .axis-d {
    margin-top: var(--space-3);
    max-width: 66ch;
    color: var(--text);
    font-size: var(--fs-small);
    line-height: 1.8;
  }

  .motors-label {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split-side {
      padding: var(--space-4) 0;
    }
    .split-side + .split-side {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }
</style>
