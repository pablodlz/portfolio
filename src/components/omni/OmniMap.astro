---
import Sec from './Sec.astro';
import { MAP_BLOCKS } from '../../lib/omni';

/**
 * O ciclo como MATRIZ entre duas travas — não como linha do tempo vertical.
 * A leitura importante não é "primeiro isto, depois aquilo": é que os sete
 * blocos giram em ciclo *entre* duas decisões humanas que o código impõe. Por
 * isso as travas são faixas, e o ciclo é uma grade de células com filete
 * compartilhado.
 */
const LOCKS_IN = [
  {
    k: 'antes de tudo',
    t: 'O operador autoriza o escopo',
    d: 'Nada acontece antes disto. O alcance da caça é uma decisão humana, registrada — e vira um portão determinístico, fora do alcance do modelo, que falha fechado.',
  },
];

const LOCKS_OUT = [
  {
    k: 'no fim',
    t: 'O humano aprova o envio',
    d: 'A plataforma monta o relatório pronto. Quem aperta o botão é uma pessoa — sempre. E o desfecho real do relatório volta como dado para a próxima caça.',
  },
];
---

<Sec
  n="01"
  id="ciclo"
  title="Um ciclo fechado, entre duas decisões humanas"
  lede="Sete blocos giram em ciclo. O que os cerca não é bom comportamento do modelo: são duas travas de código — quem autoriza no começo e quem aprova no fim. <b>Cada bloco abre a seção que o detalha.</b>"
>
  {LOCKS_IN.map((l) => (
    <div class="lock">
      <p class="o-label o-label--accent">{l.k}</p>
      <p class="lock-t">{l.t}</p>
      <p class="lock-d">{l.d}</p>
    </div>
  ))}

  <div class="cycle-mark" aria-hidden="true">
    <span class="cycle-line"></span>
    <span class="cycle-word">o ciclo</span>
    <span class="cycle-line"></span>
  </div>

  <ol class="o-matrix cycle">
    {MAP_BLOCKS.map((b) => (
      <li class="o-cell">
        <span class="o-cell-n">{b.n}</span>
        <h3 class="o-cell-t"><a href={b.href}>{b.title}</a></h3>
        <p>{b.desc}</p>
      </li>
    ))}
    <li class="o-cell is-loop">
      <span class="o-cell-n" aria-hidden="true">↻</span>
      <h3 class="o-cell-t">E recomeça</h3>
      <p>A próxima caça começa sabendo o que a anterior aprendeu — onde valeu, onde não valeu e por quê.</p>
    </li>
  </ol>

  {LOCKS_OUT.map((l) => (
    <div class="lock lock--out">
      <p class="o-label o-label--accent">{l.k}</p>
      <p class="lock-t">{l.t}</p>
      <p class="lock-d">{l.d}</p>
    </div>
  ))}
</Sec>

<style>
  .lock {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .lock--out {
    margin-top: var(--space-5);
  }
  .lock-t {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .lock-d {
    margin-top: var(--space-2);
    max-width: 68ch;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.75;
  }

  .cycle-mark {
    display: grid;
    grid-template-columns: var(--space-6) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-5) var(--space-4);
  }
  .cycle-line {
    height: 1px;
    background: var(--border-strong);
  }
  .cycle-word {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .cycle {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }
  .cycle .is-loop {
    background: var(--bg-raised);
  }
  .cycle .is-loop .o-cell-n {
    font-size: 1rem;
    line-height: 1;
  }

  @media (max-width: 1000px) {
    .cycle {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .cycle {
      grid-template-columns: 1fr;
    }
  }
</style>
