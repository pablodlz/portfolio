---
import { Image } from 'astro:assets';
import logo from '../../../img/omni-pentest/logo.png';
import { data } from '../../lib/data';
import { STATS, OMNI_VERSION, OMNI_SNAPSHOT } from '../../lib/omni';

/**
 * Capa do dossiê. Deliberadamente NÃO é o hero do portfólio (bloco central,
 * selo arredondado, quatro números lado a lado): aqui a abertura é a folha de
 * rosto de um documento — declaração em tipo grande, ficha técnica em filete e
 * os números num razão alinhado à direita.
 */
const { profile } = data;
---

<section class="cover" id="topo">
  <div class="container cover-grid">
    <div class="cover-main">
      <p class="o-label o-label--accent">Dossiê técnico · projeto autoral</p>

      <h1 class="cover-h1">Omni&#8209;Pentest</h1>

      <p class="cover-thesis">
        O agente que <em>deduz</em> a vulnerabilidade<br class="thesis-br" />
        em vez de tropeçar nela.
      </p>

      <p class="cover-body">
        Uma plataforma de segurança ofensiva conduzida por um agente de IA: aponta-se um alvo
        autorizado e ele leva a caça do reconhecimento ao relatório. A diferença está em
        <b>como</b> ele acha o bug — não disparando payloads no escuro, mas <b>aprendendo uma teoria
        formal do alvo e deduzindo a falha da estrutura dessa teoria</b>. E em <b>o que ele deixa
        passar</b>: todo achado atravessa um firewall de validação onde o padrão é descartar.
      </p>

      <dl class="o-spec cover-spec">
        <div>
          <dt>Autor</dt>
          <dd>{profile.fullName}</dd>
        </div>
        <div>
          <dt>Versão retratada</dt>
          <dd>v{OMNI_VERSION} · {OMNI_SNAPSHOT}</dd>
        </div>
        <div>
          <dt>Natureza</dt>
          <dd>Pesquisa aplicada · código-fonte fechado</dd>
        </div>
        <div>
          <dt>Uso</dt>
          <dd>Pentest e bug bounty <b>dentro de escopo autorizado</b></dd>
        </div>
      </dl>

      <p class="cover-links">
        <a href="#ciclo">Como funciona, do começo ao fim <span aria-hidden="true">↓</span></a>
        <a href="#contato">Falar com o autor</a>
      </p>
    </div>

    <aside class="cover-side">
      <Image
        class="cover-mark"
        src={logo}
        alt="Brasão do Omni-Pentest: um dragão prateado sobre escudo negro com bordas douradas"
        widths={[260, 380]}
        sizes="(max-width: 900px) 180px, 300px"
        loading="eager"
        fetchpriority="high"
      />

      <p class="o-label cover-side-label">Em números</p>
      <ul class="cover-ledger">
        {STATS.map((s) => (
          <li>
            <span class="cover-fig">
              {s.value}{s.unit && <span class="cover-unit">{s.unit}</span>}
            </span>
            <span class="cover-cap">{s.label}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .cover {
    padding-block: var(--space-8) var(--space-7);
    border-bottom: 1px solid var(--border);
  }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .cover-h1 {
    margin-top: var(--space-4);
    font-size: clamp(2.75rem, 1rem + 7vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .cover-thesis {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.9rem + 1.1vw, 1.6rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .cover-thesis em {
    font-style: normal;
    color: var(--accent);
  }
  .cover-body {
    margin-top: var(--space-5);
    max-width: 60ch;
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.8;
  }
  .cover-body b {
    color: var(--text);
    font-weight: 600;
  }

  .cover-spec {
    margin-top: var(--space-6);
    max-width: 44rem;
  }
  .cover-spec :global(b) {
    font-weight: 600;
  }

  .cover-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .cover-links a {
    color: var(--accent);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--accent-border);
  }
  .cover-links a:hover {
    border-bottom-color: var(--accent);
  }

  /* --- coluna direita --- */
  .cover-side {
    display: grid;
    justify-items: end;
  }
  .cover-mark {
    width: min(300px, 100%);
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .cover-side-label {
    margin-top: var(--space-6);
    justify-self: stretch;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-strong);
  }
  .cover-ledger {
    justify-self: stretch;
    display: grid;
    list-style: none;
  }
  .cover-ledger li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .cover-fig {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    min-width: 4.5ch;
  }
  .cover-unit {
    font-size: 0.9rem;
    margin-left: 1px;
  }
  .cover-cap {
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .cover-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .cover-side {
      justify-items: start;
    }
    .cover-mark {
      width: 180px;
    }
  }
  @media (max-width: 640px) {
    .cover {
      padding-block: var(--space-6) var(--space-6);
    }
    /* A quebra é composição de desktop: numa coluna estreita a primeira linha
       já quebra sozinha e o <br> criava uma terceira linha órfã. */
    .thesis-br {
      display: none;
    }
    .cover-thesis {
      text-wrap: pretty;
    }
    /* Dois links empilhados leem melhor que dois sublinhados colados — e a 27px
       de altura eram alvo curto demais para o dedo. */
    .cover-links {
      gap: var(--space-2);
    }
    .cover-links a {
      width: fit-content;
      padding-block: var(--space-2);
    }
  }
</style>
