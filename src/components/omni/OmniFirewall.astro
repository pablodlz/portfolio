---
import Sec from './Sec.astro';
import { OUTCOMES } from '../../lib/omni';

/**
 * Os nove portões de validade, na ordem em que o candidato os atravessa. O
 * décimo — a nota recalculada — não é um portão de "sim/não" como os outros:
 * ganha a faixa inteira embaixo da escada.
 */
const GATES = [
  { g: 'Evidência estruturada', q: 'existe registro, ou só prosa convincente?' },
  { g: 'Escopo', q: 'o alvo estava autorizado?' },
  { g: 'Identidade', q: 'quem agiu era mesmo quem se diz?' },
  { g: 'Exploração real', q: 'saiu do "seria possível" para o "aconteceu"?' },
  { g: 'Efeito ponta a ponta', q: 'a vítima sente o efeito, não só o atacante?' },
  { g: 'Classe de impacto', q: 'o dano cabe numa taxonomia reconhecida?' },
  { g: 'Duplicidade', q: 'já não é a mesma causa raiz de outro achado?' },
  { g: 'Reprodutibilidade', q: 'roda de novo, do zero, com os mesmos passos?' },
  { g: 'Juiz adversarial', q: 'sobrevive a alguém tentando derrubá-lo?' },
];
---

<Sec
  n="05"
  id="firewall"
  title="Um firewall onde o padrão é descartar"
  lede="É o que separa um achado real de ruído bem escrito. Todo candidato — venha de qualquer motor — entra pela mesma porta, e a maioria não sai dela."
>
  <p class="o-label gates-label">A escada — reprovou em um, morreu</p>

  <ol class="gates">
    {GATES.map((x, i) => (
      <li class="gate">
        <span class="gate-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="gate-g">{x.g}</span>
        <span class="gate-q">{x.q}</span>
      </li>
    ))}
  </ol>

  <div class="tenth">
    <p class="tenth-n" aria-hidden="true">10</p>
    <div>
      <h3 class="tenth-t">A nota é recalculada pelo código</h3>
      <p class="tenth-d">
        Não basta passar: a confiança é <b>recomputada a partir da evidência</b>, e o número que o
        modelo acha que merece é ignorado. Só a <b>nota máxima</b>, com todos os portões aprovados,
        abre um relatório. A gravidade também é derivada — cada elevação precisa ser paga com uma
        prova estruturada, e achado somente de leitura não vira crítico.
      </p>
    </div>
  </div>

  <p class="o-label out-label">Os cinco destinos possíveis</p>
  <div class="o-table-wrap">
    <table class="o-table">
      <thead>
        <tr>
          <th scope="col">Destino</th>
          <th scope="col">O que significa</th>
          <th scope="col">Quem decide o próximo passo</th>
        </tr>
      </thead>
      <tbody>
        {OUTCOMES.map((o) => (
          <tr class:list={[`is-${o.tone}`]}>
            <th scope="row">{o.key}</th>
            <td>{o.means}</td>
            <td class="o-who">{o.who}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Sec>

<style>
  .gates-label {
    display: block;
    margin-top: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-strong);
  }
  .gates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-7);
    list-style: none;
  }
  .gate {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    row-gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .gate-n {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .gate-g {
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--text);
  }
  .gate-q {
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }

  .tenth {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .tenth-n {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .tenth-t {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }
  .tenth-d {
    margin-top: var(--space-2);
    max-width: 64ch;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .tenth-d b {
    color: var(--text);
    font-weight: 600;
  }

  .out-label {
    display: block;
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
  }
  /* cabeçalho de LINHA é nome próprio, não rótulo de coluna: desfaz o mono/caixa-alta */
  .o-table th[scope='row'] {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: none;
    letter-spacing: -0.01em;
    white-space: normal;
    vertical-align: top;
  }
  /* o único destino que vira relatório ganha o filete de acento */
  .o-table tr.is-win th[scope='row'] {
    box-shadow: inset 3px 0 0 var(--accent);
    padding-left: var(--space-4);
  }

  @media (max-width: 820px) {
    .gates {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .tenth {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .tenth-n {
      font-size: 2rem;
    }
  }
</style>
