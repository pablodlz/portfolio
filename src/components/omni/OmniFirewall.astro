---
import Sec from './Sec.astro';
import Deep from './Deep.astro';
import Fig from './Fig.astro';
import {
  OUTCOMES,
  UNLOCK,
  REPORT_STAGES,
  PLATFORM_VERDICTS,
  SEVERITY_CASCADE,
  SEVERITY_NOTE,
  AXES_NOTE,
  HARDENERS,
} from '../../lib/omni';

/**
 * Os nove portões de validade, na ordem em que o candidato os atravessa. O
 * décimo — a nota recalculada — não é um portão de "sim/não" como os outros:
 * ganha a faixa inteira embaixo da escada.
 */
const GATES = [
  { g: 'Evidência estruturada', q: 'existe registro, ou só prosa convincente?' },
  { g: 'Escopo', q: 'o alvo estava autorizado?' },
  { g: 'Identidade', q: 'quem agiu era mesmo quem se diz?' },
  { g: 'Exploração real', q: 'saiu do "seria possível" para o "aconteceu"?' },
  { g: 'Efeito ponta a ponta', q: 'a vítima sente o efeito, não só o atacante?' },
  { g: 'Classe de impacto', q: 'o dano cabe numa taxonomia reconhecida?' },
  { g: 'Duplicidade', q: 'já não é a mesma causa raiz de outro achado?' },
  { g: 'Reprodutibilidade', q: 'roda de novo, do zero, com os mesmos passos?' },
  { g: 'Juiz adversarial', q: 'sobrevive a alguém tentando derrubá-lo?' },
];
---

<Sec
  n="05"
  id="firewall"
  title="Um firewall onde o padrão é descartar"
  lede="É o que separa um achado real de ruído bem escrito. Todo candidato — venha de qualquer motor — entra pela mesma porta, e a maioria não sai dela."
>
  <p class="pre">
    <span class="pre-k">Antes da escada</span>
    <span class="pre-v">
      Um crivo de rejeição automática mata as classes conhecidas de ruído sem gastar um portão sequer.
      O que sobra é que enfrenta os dez.
    </span>
  </p>

  <Fig
    src="firewall.svg"
    alt="O funil de validação: a rejeição automática mata o ruído conhecido, os dez portões levam à confiança recomputada, e daí ou o achado vai para uma das filas de espera, ou é descartado, ou — com nota máxima e sem duplicata — vira relatório; em paralelo, a severidade é derivada da evidência"
    w={1440}
    h={1431}
    min={960}
    kicker="figura 4"
    caption="O funil inteiro. Repare que o descarte se parte em <b>duas filas diferentes</b>, e a pergunta que as separa é sempre a mesma: <b>quem destrava este achado?</b> A caixa dourada à direita é ortogonal — mede a magnitude do que sobreviveu, e nunca ressuscita o que foi descartado."
  />

  <p class="o-label gates-label">A escada — reprovou em um, morreu</p>

  <ol class="gates">
    {GATES.map((x, i) => (
      <li class="gate">
        <span class="gate-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="gate-g">{x.g}</span>
        <span class="gate-q">{x.q}</span>
      </li>
    ))}
  </ol>

  <div class="tenth">
    <p class="tenth-n" aria-hidden="true">10</p>
    <div>
      <h3 class="tenth-t">A nota é recalculada pelo código</h3>
      <p class="tenth-d">
        Não basta passar: a confiança é <b>recomputada a partir da evidência</b>, e o número que o
        modelo acha que merece é ignorado. Só a <b>nota máxima</b>, com todos os portões aprovados,
        abre um relatório.
      </p>
    </div>
  </div>

  <p class="o-label out-label">Os cinco destinos possíveis</p>
  <div class="o-table-wrap">
    <table class="o-table">
      <thead>
        <tr>
          <th scope="col">Destino</th>
          <th scope="col">O que significa</th>
          <th scope="col">Quem decide o próximo passo</th>
        </tr>
      </thead>
      <tbody>
        {/* `data-label`: no celular a tabela vira ficha empilhada (omni.css) */}
        {OUTCOMES.map((o) => (
          <tr class:list={[`is-${o.tone}`]}>
            <th scope="row">{o.key}</th>
            <td data-label="O que significa">{o.means}</td>
            <td class="o-who" data-label="Quem decide o próximo passo">{o.who}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class="sub">{UNLOCK.title}</h3>
  <p class="sub-lede" set:html={UNLOCK.lead} />
  <div class="o-rows">
    {UNLOCK.rows.map((r) => (
      <div class="o-row is-key">
        <div class="o-row-k">{r.k}</div>
        <p class="o-row-v" set:html={r.v} />
      </div>
    ))}
  </div>
  <p class="tail" set:html={UNLOCK.tail} />

  <h3 class="sub">Onde o achado está ≠ em que pé está o relatório</h3>
  <p class="sub-lede">
    São eixos ortogonais, e cada um tem seu dono: a <b>camada</b> responde <em>quem destrava</em>; o
    <b>ciclo de relatório</b> responde <em>onde ele está entre a prova e o pagamento</em>.
  </p>
  <div class="o-flow" aria-label="O ciclo de relatório">
    {REPORT_STAGES.map((s, i) => (
      <span class:list={[i === REPORT_STAGES.length - 1 && 'is-end']}>{s.name}</span>
    ))}
  </div>
  <dl class="o-spec stages">
    {REPORT_STAGES.map((s) => (
      <div>
        <dt>{s.n} · {s.name}</dt>
        <dd>{s.what}</dd>
      </div>
    ))}
  </dl>
  <p class="o-label verdict-label">E um fechado carrega o veredito da plataforma</p>
  <div class="o-chips">
    {PLATFORM_VERDICTS.map((v) => (
      <span class:list={['o-chip', v === 'pago' && 'o-chip--accent']}>{v}</span>
    ))}
  </div>
  <p class="tail" set:html={AXES_NOTE} />

  <h3 class="sub">A gravidade é calculada, não escolhida</h3>
  <p class="sub-lede">
    Cinco degraus, aplicados em ordem — e o painel marca <b>qual deles de fato mordeu</b>, respondendo
    <em>"por que isto não é Crítico?"</em> em vez de só declarar a banda.
  </p>
  <ol class="o-steps cascade">
    {SEVERITY_CASCADE.map((s) => (
      <li class="o-step">
        <span class="o-step-n" aria-hidden="true">{s.n}</span>
        <div>
          <p class="o-step-t">{s.name}</p>
          <p class="o-step-b" set:html={s.what} />
        </div>
      </li>
    ))}
  </ol>

  <Deep summary="As regras que sustentam o funil">
    <h4>Validade e magnitude são eixos separados</h4>
    <p set:html={SEVERITY_NOTE} />
    <h4>Três reforços endurecem a saída</h4>
    {HARDENERS.map((h) => (
      <p>
        <b>{h.name}.</b> <span set:html={h.what} />
      </p>
    ))}
    <h4>E a divisão do descarte sai do código, não de um campo de texto</h4>
    <p>
      Qual das duas filas recebe um achado rebaixado é decidido pelo <b>ramo de código que já
      decidia</b> — nunca por um campo que o modelo preenche à mão em prosa livre. Medido, esse campo
      acerta pouco mais de um terço das vezes: bom como pista para um humano ler, péssimo como chave
      de classificação.
    </p>
  </Deep>
</Sec>

<style>
  .pre {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid var(--border-strong);
  }
  .pre-k {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pre-v {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
    max-width: 62ch;
  }

  .gates-label {
    display: block;
    margin-top: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-strong);
  }
  .gates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-7);
    list-style: none;
  }
  .gate {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    row-gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .gate-n {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .gate-g {
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--text);
  }
  .gate-q {
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }

  .tenth {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .tenth-n {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .tenth-t {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }
  .tenth-d {
    margin-top: var(--space-2);
    max-width: 64ch;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .tenth-d b {
    color: var(--text);
    font-weight: 600;
  }

  .out-label {
    display: block;
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
  }
  /* cabeçalho de LINHA é nome próprio, não rótulo de coluna: desfaz o mono/caixa-alta */
  .o-table th[scope='row'] {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: none;
    letter-spacing: -0.01em;
    white-space: normal;
    vertical-align: top;
  }
  /* o único destino que vira relatório ganha o filete de acento */
  .o-table tr.is-win th[scope='row'] {
    box-shadow: inset 3px 0 0 var(--accent);
    padding-left: var(--space-4);
  }

  /* subseções dentro do §05 — o firewall tem mais de uma regra a explicar */
  .sub {
    margin-top: var(--space-7);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .sub-lede {
    margin-block: var(--space-3) var(--space-5);
    max-width: 64ch;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .sub-lede b {
    color: var(--text);
    font-weight: 600;
  }
  .tail {
    margin-top: var(--space-4);
    max-width: 64ch;
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.8;
  }
  .tail b {
    color: var(--text-2);
    font-weight: 600;
  }

  .stages {
    margin-top: var(--space-5);
  }
  /* "00 · NÃO ELEGÍVEL" não cabe em 9rem e quebrava a chave em duas linhas */
  .stages div {
    grid-template-columns: 11rem minmax(0, 1fr);
  }
  .stages dt {
    font-variant-numeric: tabular-nums;
  }
  .stages dd {
    color: var(--text-2);
  }
  .verdict-label {
    display: block;
    margin-block: var(--space-6) var(--space-3);
  }
  .cascade {
    margin-top: var(--space-2);
    list-style: none;
  }

  @media (max-width: 820px) {
    .gates {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .pre,
    .stages div {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    /* a tabela virou ficha empilhada: o destino é o TÍTULO do cartão */
    .o-table th[scope='row'] {
      padding: 0 0 var(--space-3) 0;
      font-size: var(--fs-body);
    }
    /* o filete do vencedor passa a marcar a ficha inteira, não a célula */
    .o-table tr.is-win {
      border-color: var(--accent-border);
      box-shadow: inset 3px 0 0 var(--accent);
    }
    .o-table tr.is-win th[scope='row'] {
      box-shadow: none;
      padding-left: 0;
    }
  }
  @media (max-width: 560px) {
    .tenth {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .tenth-n {
      font-size: 2rem;
    }
  }
</style>
