---
import ThemeToggle from '../ui/ThemeToggle.astro';
import Icon from '../ui/Icon.astro';
import { withBase } from '../../lib/url';

/**
 * A marca continua sendo a DELE: quem chega aqui está dentro do portfólio de
 * @pablodlz, na página de um projeto — não num site de produto. Por isso o
 * cabeçalho abre com o handle e um rastro "projetos / omni-pentest", e os links
 * voltam para as seções do portfólio, não só para a home.
 */
const BACK = [
  { href: withBase('/#projetos'), label: 'Projetos' },
  { href: withBase('/#experiencia'), label: 'Experiência' },
  { href: withBase('/#contato'), label: 'Contato' },
];

const HERE = [
  { href: '#ciclo', label: '01 ciclo' },
  { href: '#metodo', label: '03 método' },
  { href: '#firewall', label: '05 firewall' },
  { href: '#console', label: '07 console' },
];
---

<header class="onav-wrap">
  <div class="container onav">
    <a class="onav-brand" href={withBase('/')}>
      <span class="onav-at">@</span>pablodlz<span class="onav-cursor">_</span>
    </a>

    <nav class="onav-crumb" aria-label="Localização">
      <a href={withBase('/#projetos')}>projetos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">omni&#8209;pentest</span>
    </nav>

    <nav class="onav-here" aria-label="Seções do dossiê">
      {HERE.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="onav-actions">
      <details class="onav-more">
        <summary aria-label="Mais destinos">
          <Icon name="chevron-down" size={16} />
          <span>Ir para</span>
        </summary>
        <div class="onav-panel">
          <p class="o-label">Neste dossiê</p>
          <ul>
            {HERE.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
          <p class="o-label">No portfólio</p>
          <ul>
            {BACK.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </details>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const more = document.querySelector<HTMLDetailsElement>('.onav-more');
  more?.addEventListener('click', (ev) => {
    if ((ev.target as HTMLElement).closest('a')) more.open = false;
  });
</script>

<style>
  /* sólido + filete: o portfólio usa vidro fosco, aqui é papel timbrado */
  .onav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .onav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 56px;
  }

  .onav-brand {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .onav-brand:hover {
    color: var(--accent);
  }
  .onav-at {
    color: var(--accent);
  }
  .onav-cursor {
    color: var(--text-3);
  }

  .onav-crumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
    white-space: nowrap;
  }
  .onav-crumb a:hover {
    color: var(--accent);
  }
  .onav-crumb [aria-current] {
    color: var(--text);
  }

  .onav-here {
    display: flex;
    gap: var(--space-5);
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .onav-here a:hover {
    color: var(--accent);
  }

  .onav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .onav-more {
    position: relative;
  }
  .onav-more summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
  }
  .onav-more summary::-webkit-details-marker {
    display: none;
  }
  .onav-more[open] summary {
    border-color: var(--accent-border);
    color: var(--accent);
  }
  .onav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: grid;
    gap: var(--space-2);
    min-width: 12rem;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    box-shadow: var(--shadow-lightbox);
  }
  .onav-panel ul {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    list-style: none;
  }
  .onav-panel a {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .onav-panel a:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .onav-here {
      display: none;
    }
    .onav-crumb {
      margin-right: auto;
    }
  }
  @media (max-width: 560px) {
    .onav {
      gap: var(--space-3);
    }
    .onav-crumb {
      padding-left: var(--space-3);
    }
    /* espaço curto: o rastro encolhe para o nó atual — "projetos" continua no
       painel "Ir para" e na marca à esquerda. Sem isso o botão de tema é cortado. */
    .onav-crumb a,
    .onav-crumb [aria-hidden] {
      display: none;
    }
    .onav-more summary span {
      display: none;
    }
  }
  @media (min-width: 901px) {
    .onav-more {
      display: none;
    }
  }
</style>
