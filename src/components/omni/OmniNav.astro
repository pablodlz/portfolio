---
import ThemeToggle from '../ui/ThemeToggle.astro';
import Icon from '../ui/Icon.astro';
import { withBase } from '../../lib/url';

/**
 * A marca continua sendo a DELE: quem chega aqui está dentro do portfólio de
 * @pablodlz, na página de um projeto — não num site de produto. Por isso o
 * cabeçalho abre com o handle e um rastro "projetos / omni-pentest", e os links
 * voltam para as seções do portfólio, não só para a home.
 */
const BACK = [
  { href: withBase('/#projetos'), label: 'Projetos' },
  { href: withBase('/#experiencia'), label: 'Experiência' },
  { href: withBase('/#contato'), label: 'Contato' },
];

const HERE = [
  { href: '#metodo', label: '03 método' },
  { href: '#firewall', label: '05 firewall' },
  { href: '#arquitetura', label: '08 arquitetura' },
  { href: '#console', label: '10 console' },
];

/** O sumário completo — vive só no painel "Ir para", que tem espaço para 11. */
const ALL = [
  { href: '#ciclo', label: '01 ciclo' },
  { href: '#fases', label: '02 fases' },
  { href: '#metodo', label: '03 método' },
  { href: '#operador', label: '04 operador' },
  { href: '#firewall', label: '05 firewall' },
  { href: '#conhecimento', label: '06 conhecimento' },
  { href: '#arsenal', label: '07 arsenal' },
  { href: '#arquitetura', label: '08 arquitetura' },
  { href: '#harness', label: '09 harness' },
  { href: '#console', label: '10 console' },
  { href: '#garantias', label: '11 garantias' },
];
---

<header class="onav-wrap">
  <div class="container onav">
    <a class="onav-brand" href={withBase('/')}>
      <span class="onav-at">@</span>pablodlz<span class="onav-cursor">_</span>
    </a>

    <nav class="onav-crumb" aria-label="Localização">
      {/* o nome acessível vem do aria-label porque abaixo de 400px sobra só a
          seta — e "←" sozinho não se anuncia */}
      <a href={withBase('/#projetos')} aria-label="Voltar para Projetos">
        <span class="crumb-back" aria-hidden="true">←</span><span class="crumb-word">projetos</span>
      </a>
      <span class="crumb-sep" aria-hidden="true">/</span>
      <span class="crumb-here" aria-current="page">omni&#8209;pentest</span>
    </nav>

    <nav class="onav-here" aria-label="Seções do dossiê">
      {HERE.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="onav-actions">
      <details class="onav-more">
        <summary aria-label="Mais destinos">
          <Icon name="chevron-down" size={16} />
          <span>Ir para</span>
        </summary>
        <div class="onav-panel">
          <p class="o-label">Neste dossiê</p>
          <ul>
            {ALL.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
          <p class="o-label">No portfólio</p>
          <ul>
            {BACK.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </details>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const more = document.querySelector<HTMLDetailsElement>('.onav-more');
  more?.addEventListener('click', (ev) => {
    if ((ev.target as HTMLElement).closest('a')) more.open = false;
  });
</script>

<style>
  /* sólido + filete: o portfólio usa vidro fosco, aqui é papel timbrado */
  .onav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .onav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 56px;
  }

  .onav-brand {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .onav-brand:hover {
    color: var(--accent);
  }
  .onav-at {
    color: var(--accent);
  }
  .onav-cursor {
    color: var(--text-3);
  }

  .onav-crumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
    white-space: nowrap;
  }
  .onav-crumb a:hover {
    color: var(--accent);
  }
  .onav-crumb [aria-current] {
    color: var(--text);
  }

  .onav-here {
    display: flex;
    gap: var(--space-5);
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .onav-here a:hover {
    color: var(--accent);
  }

  .onav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .onav-more {
    position: relative;
  }
  .onav-more summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* sem isto o rótulo quebra em "Ir / para" quando a barra aperta */
    white-space: nowrap;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
  }
  .onav-more summary::-webkit-details-marker {
    display: none;
  }
  .onav-more[open] summary {
    border-color: var(--accent-border);
    color: var(--accent);
  }
  .onav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: grid;
    gap: var(--space-2);
    min-width: 12rem;
    /* onze seções + três voltas ao portfólio: rola dentro do painel, não empurra a página */
    max-height: min(70vh, 26rem);
    overflow-y: auto;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    box-shadow: var(--shadow-lightbox);
  }
  .onav-panel ul {
    display: grid;
    margin-bottom: var(--space-2);
    list-style: none;
  }
  /* Este painel É a navegação no celular: com 17px de altura os itens ficavam
     colados e o dedo errava de seção. Cada linha vira uma faixa de ~40px. */
  .onav-panel a {
    display: block;
    padding: 9px 8px;
    margin-inline: -8px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .onav-panel a:hover {
    color: var(--accent);
    background: var(--bg);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .onav-here {
      display: none;
    }
    .onav-crumb {
      margin-right: auto;
    }
  }
  /* a seta só aparece quando o rastro vira botão de voltar (≤560px) */
  .crumb-back {
    display: none;
    margin-right: 3px;
    color: var(--text-3);
  }

  @media (max-width: 560px) {
    .onav {
      gap: var(--space-3);
    }
    .onav-crumb {
      padding-left: var(--space-3);
    }
    /* alvo de toque na barra: o texto sozinho dá 22px, metade do confortável */
    .onav-crumb a,
    .onav-brand {
      display: inline-block;
      padding-block: 8px;
      margin-block: -8px;
    }
    .onav-actions {
      flex: none;
      margin-left: auto;
      gap: 6px;
    }
    /* ~10px arrancados do botão são o que separa "←projetos" de "←projet…" */
    .onav-more summary {
      gap: 4px;
      padding: 6px 8px;
    }
    /* Espaço curto: some o nó ATUAL, não o caminho de volta. "omni-pentest" é
       redundante (o título gigante logo abaixo diz o mesmo), enquanto "projetos"
       é a única saída daqui — e escondê-la deixava o celular sem volta. */
    .crumb-sep,
    .crumb-here {
      display: none;
    }
    .crumb-back {
      display: inline;
    }
  }
  /* Telas de 320–380px: nem "←projetos" cabe junto da marca e do botão. Fica a
     seta sozinha — a afordância de voltar universal no celular — com o nome
     acessível preservado no aria-label do link. */
  @media (max-width: 384px) {
    .crumb-word {
      display: none;
    }
    .onav-crumb a {
      display: inline-flex;
      align-items: center;
      /* alvo de toque: a seta sozinha teria ~10px de largura */
      padding: 8px 6px;
      margin: -8px -6px;
      font-size: var(--fs-small);
    }
    .crumb-back {
      margin-right: 0;
      color: var(--text-2);
    }
  }
  @media (min-width: 901px) {
    .onav-more {
      display: none;
    }
  }
</style>
