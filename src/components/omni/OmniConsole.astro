---
import Sec from './Sec.astro';
import Deep from './Deep.astro';
import { withBase } from '../../lib/url';
import { CONSOLE_PAGES, CONSOLE_DETAILS, CONSOLE_SPEC } from '../../lib/omni';
---

<Sec
  n="10"
  id="console"
  band
  title="O portfólio inteiro num relance"
  lede="Depois que a caça roda e os achados entram, é aqui que se revê tudo. O painel lê e escreve pelos <b>mesmos caminhos validados</b> que o agente usa — a interface nunca vira uma segunda fonte da verdade."
>
  <figure class="shot">
    {/* A 340px de largura o painel não se lê. O toque abre o GIF em tamanho
        natural — a única saída num aparelho estreito para uma figura larga. */}
    <a
      class="shot-zoom"
      href={withBase('/omni-pentest/operator-console.gif')}
      target="_blank"
      rel="noopener"
      aria-label="Abrir a animação do console em tamanho original"
    >
      <img
        src={withBase('/omni-pentest/operator-console.gif')}
        alt="As dez páginas do console em sequência, da postura do portfólio até a configuração da instalação"
        width="1100"
        height="688"
        loading="lazy"
        decoding="async"
      />
      <span class="shot-hint" aria-hidden="true">toque para ampliar</span>
    </a>
    <figcaption>
      <span class="shot-cap-k">figura única</span>
      As dez páginas em sequência, sobre uma instalação real — 40 alvos, 144 achados.
      <b>Nomes de programa e de achado estão anonimizados</b>: são vulnerabilidades ainda não
      corrigidas em programas reais.
    </figcaption>
  </figure>

  <p class="o-label pages-label">Sumário do painel — cada página responde a uma pergunta</p>
  <ol class="o-index pages">
    {CONSOLE_PAGES.map((p, i) => (
      <li>
        <span class="o-index-n">
          <span class="pages-n">{String(i + 1).padStart(2, '0')}</span>{p.name}
        </span>
        <span class="o-index-dots" aria-hidden="true"></span>
        <span class="o-index-q">{p.answers}</span>
      </li>
    ))}
  </ol>

  <dl class="o-spec cspec">
    {CONSOLE_SPEC.map((s) => (
      <div>
        <dt>{s.k}</dt>
        <dd set:html={s.v} />
      </div>
    ))}
  </dl>

  <Deep summary="O que cada painel mostra">
    {CONSOLE_DETAILS.map((d) => (
      <>
        <h4>{d.title}</h4>
        {d.body.map((p) => (
          <p set:html={p} />
        ))}
      </>
    ))}
  </Deep>

  <p class="o-note">
    O relatório <b>sai</b> do painel — copiado, revisado e enviado por uma pessoa. Nenhum botão ali
    submete coisa alguma a plataforma nenhuma.
  </p>
</Sec>

<style>
  .shot {
    margin-top: var(--space-6);
  }
  .shot-zoom {
    position: relative;
    display: block;
  }
  .shot-zoom:hover {
    text-decoration: none;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }
  .shot-zoom:hover img {
    border-color: var(--accent-border);
  }
  /* a dica só faz sentido onde a figura de fato não se lê */
  .shot-hint {
    display: none;
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 4px 8px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  @media (max-width: 720px) {
    .shot-hint {
      display: block;
    }
  }
  .shot figcaption {
    margin-top: var(--space-3);
    max-width: 70ch;
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.75;
  }
  .shot-cap-k {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-right: var(--space-2);
  }
  .shot figcaption b {
    color: var(--text-2);
  }

  .pages-label {
    display: block;
    margin-top: var(--space-7);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-strong);
  }
  .pages {
    margin-top: var(--space-4);
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-7);
    list-style: none;
  }
  .pages-n {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-right: var(--space-3);
  }

  .cspec {
    margin-top: var(--space-7);
  }
  .cspec div {
    grid-template-columns: 8rem minmax(0, 1fr);
  }
  .cspec dd {
    color: var(--text-2);
    line-height: 1.8;
  }
  .cspec dd b {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .pages {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .cspec div {
      grid-template-columns: 1fr;
    }
  }
</style>
