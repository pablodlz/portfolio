---
import { withBase } from '../../lib/url';

/**
 * Figura do dossiê: um diagrama (ou a captura do console) sobre uma placa
 * escura, com legenda e saída para o tamanho original.
 *
 * A figura **sempre aparece inteira**: encolhe até caber na coluna, em qualquer
 * largura, e a placa nunca rola de lado. Foi uma decisão explícita do autor —
 * uma figura cortada é lida como um erro da página, enquanto uma figura pequena
 * é lida como uma miniatura, e miniatura tem para onde ir.
 *
 * O custo é real e por isso a saída fica ao lado: num telefone estreito o texto
 * de um mapa de 1100px chega a ~5px. Daí a imagem inteira ser um link para o
 * arquivo original — e o aviso aparecer justamente nas larguras em que o
 * encolhimento morde.
 */
interface Props {
  /** nome do arquivo em /omni-pentest/diagramas/ (ou o caminho completo, se `raw`) */
  src: string;
  alt: string;
  /** dimensões naturais — reservam a caixa e evitam o pulo do layout */
  w: number;
  h: number;
  /** rótulo curto antes da legenda ("figura 1", "diagrama") */
  kicker?: string;
  /** legenda — aceita HTML */
  caption: string;
  /** a figura de abertura carrega adiantada; as demais são preguiçosas */
  eager?: boolean;
  /** o `src` já é um caminho completo do site (usado pelo GIF do console) */
  raw?: boolean;
}

const { src, alt, w, h, kicker, caption, eager = false, raw = false } = Astro.props;
const href = withBase(raw ? src : `/omni-pentest/diagramas/${src}`);
---

<figure class="fig">
  <div class="fig-plate">
    <a class="fig-open" href={href} target="_blank" rel="noopener" aria-label={`Abrir em tamanho original: ${alt}`}>
      <img
        src={href}
        alt={alt}
        width={w}
        height={h}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </a>
  </div>
  <figcaption>
    {kicker && <span class="fig-k">{kicker}</span>}
    <span set:html={caption} />
    {/* Só nas larguras em que a figura encolhe a ponto de o texto dela apertar.
        Num desktop onde ela cabe legível, seria instrução para um problema que
        não existe. */}
    <span class="fig-hint">Toque na figura para abri-la em tamanho original.</span>
  </figcaption>
</figure>

<style>
  .fig {
    margin-top: var(--space-6);
  }

  .fig-plate {
    padding: var(--space-5);
    border: 1px solid var(--plate-border);
    border-radius: var(--radius-md);
    background: var(--plate);
  }
  .fig-open {
    display: block;
  }
  .fig-open:hover {
    text-decoration: none;
  }
  .fig-plate img {
    display: block;
    /* encolhe o quanto for preciso para caber inteira; nunca AMPLIA além do
       natural — esticar o GIF de 1100px numa tela larga só o borraria */
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .fig figcaption {
    margin-top: var(--space-3);
    max-width: 70ch;
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.75;
  }
  .fig-k {
    margin-right: var(--space-2);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .fig figcaption :global(b) {
    color: var(--text-2);
  }
  .fig-hint {
    display: none;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .fig-hint {
      display: block;
    }
  }
  @media (max-width: 720px) {
    /* a placa come 32px de largura útil justo onde ela é mais escassa — e agora
       cada pixel dela vira tamanho de letra dentro da figura */
    .fig-plate {
      padding: var(--space-3);
    }
  }
</style>
