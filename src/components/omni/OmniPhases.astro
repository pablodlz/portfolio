---
import Sec from './Sec.astro';
import Deep from './Deep.astro';
import { PHASES, DEEP_MODE } from '../../lib/omni';
---

<Sec
  n="02"
  id="fases"
  title="Seis fases, uma superfície por vez"
  lede="O agente caminha por uma máquina de fases, consulta o conhecimento antes de agir e registra o que já testou — para não repetir a si mesmo nem esquecer o que ficou aberto."
>
  <div class="o-flow" aria-label="A máquina de fases">
    <span>INIT</span>
    {PHASES.map((p) => (
      <span>{p.code}</span>
    ))}
    <span class="is-end">DONE</span>
  </div>
  <p class="loops">
    Duas arestas voltam: superfície nova descoberta reentra no <b>filtro de escopo</b>, e o que a
    validação reprova volta para a <b>exploração</b> — não para o lixo.
  </p>

  <div class="o-rows">
    {PHASES.map((p, i) => (
      <div class="o-row">
        <div class="o-row-k">
          <span class="o-row-i">{String(i + 1).padStart(2, '0')}</span>{p.name}
        </div>
        <p class="o-row-v" set:html={p.what} />
      </div>
    ))}
  </div>

  <Deep summary="O que cada fase faz por dentro">
    {PHASES.map((p) => (
      <>
        <h4>{p.name}</h4>
        {p.deep.map((d) => (
          <p set:html={d} />
        ))}
      </>
    ))}
    <h4>{DEEP_MODE.title}</h4>
    {DEEP_MODE.body.map((d) => (
      <p set:html={d} />
    ))}
  </Deep>

  <p class="o-note" set:html={DEEP_MODE.lead} />
</Sec>

<style>
  .loops {
    margin-top: var(--space-3);
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.7;
    max-width: 62ch;
  }
  .loops b {
    color: var(--text-2);
    font-weight: 600;
  }
</style>
