---
import { data } from '../../lib/data';
import { withBase } from '../../lib/url';
import { OMNI_VERSION } from '../../lib/omni';

/**
 * Colofão, não rodapé de site: uma faixa fina com autoria, versão retratada e
 * os caminhos de volta ao portfólio. O sumário do dossiê já é o cabeçalho — não
 * se repete aqui em três colunas de links (isso seria o rodapé do portfólio de novo).
 */
const year = new Date().getFullYear();
const { profile } = data;
---

<footer class="colophon">
  <div class="container colophon-row">
    <p class="colophon-id">
      <a href={withBase('/')} class="colophon-brand">@pablodlz</a>
      <span class="colophon-sep" aria-hidden="true">·</span>
      <span>Omni&#8209;Pentest, dossiê da versão <b>v{OMNI_VERSION}</b></span>
      <span class="colophon-sep" aria-hidden="true">·</span>
      <span>© {year} {profile.fullName}</span>
    </p>

    <nav class="colophon-links" aria-label="Caminhos de volta">
      <a href={withBase('/')}>Portfólio</a>
      <a href={withBase('/#projetos')}>Projetos</a>
      <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="#topo">Topo &#8593;</a>
    </nav>
  </div>

  <p class="container colophon-legal">
    Ferramenta de segurança ofensiva para uso <b>estritamente autorizado</b> — pentest e bug bounty
    dentro de escopo permitido. O código-fonte é privado: esta página descreve o funcionamento, não a
    implementação.
  </p>
</footer>

<style>
  .colophon {
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--border);
  }
  .colophon-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .colophon-id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .colophon-id b {
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .colophon-brand {
    color: var(--text);
    font-weight: 700;
  }
  .colophon-brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .colophon-sep {
    color: var(--border-strong);
  }

  .colophon-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .colophon-links a {
    color: var(--text-3);
  }
  .colophon-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .colophon-legal {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    max-width: 64rem;
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: 1.75;
  }
  .colophon-legal b {
    color: var(--text-2);
  }
</style>
