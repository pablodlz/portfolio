---
import { Image } from 'astro:assets';
import omniLogo from '../../../img/omni-pentest/logo.png';
import { data, publicationByUrn } from '../../lib/data';
import { formatYearMonth, formatIsoDate } from '../../lib/dates';
import { withBase } from '../../lib/url';
import { OMNI_VERSION } from '../../lib/omni';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';

const { projects, speaking } = data;
// Destaque com página própria (/omni-pentest) — não vem do LinkedIn, então não
// entra em linkedin.json (ADR-0004: aquele JSON é a exportação curada, e só).
const OMNI_SKILLS = [
  'Segurança Ofensiva',
  'Bug Bounty',
  'IA aplicada',
  'Python',
  'Clean Architecture',
];
// A métrica do artigo vem do texto do JSON (não inventar números).
const METRIC = /redução de ([\d,]+%)/;
---

<section id="projetos" class="section projects">
  <div class="container">
    <SectionHeading
      eyebrow="research"
      title="Projetos & Pesquisa"
      description="Pesquisa aplicada em ML × ransomware e AppSec levada a palco."
    />

    <a class="proj-featured reveal" href={withBase('/omni-pentest')}>
      {/* O brasão no lugar do ícone genérico: o projeto tem marca própria, e é
          ela que a pessoa vai reencontrar na página do dossiê. Decorativo
          (alt vazio) — quem dá o nome acessível ao card é o título logo ao lado. */}
      <span class="pf-media">
        <Image
          class="pf-logo"
          src={omniLogo}
          alt=""
          widths={[144, 216]}
          sizes="72px"
          loading="lazy"
          decoding="async"
        />
      </span>
      <span class="pf-body">
        <span class="pf-top">
          <Badge tone="accent">Projeto autoral</Badge>
          <span class="pf-version">v{OMNI_VERSION}</span>
        </span>
        <span class="pf-title">Omni&#160;Pentest</span>
        <span class="pf-desc">
          Plataforma de bug bounty conduzida por um agente de IA que <b>modela o alvo e deduz a
          vulnerabilidade</b> — em vez de só disparar payloads. Todo achado passa por um firewall de
          validação de dez portões onde o padrão é <b>descartar</b>, e nenhum relatório sai sem
          aprovação humana.
        </span>
        <span class="pf-skills">
          {OMNI_SKILLS.map((s) => (
            <Tag>{s}</Tag>
          ))}
        </span>
        <span class="pf-cta">
          Conhecer o projeto
          <Icon name="arrow-right" size={16} />
        </span>
      </span>
    </a>

    <div class="proj-grid">
      {projects.map((p, i) => {
        const metric = METRIC.exec(p.description)?.[1];
        const related = p.relatedPublications.map(publicationByUrn);
        const isTalks = p.category === 'Palestras e Minicursos';
        return (
          <Card as="article" class="proj-card reveal" data-ri={i}>
            <Badge tone="info">{p.category}</Badge>
            <h3>{p.name}</h3>
            <p class="proj-desc">{p.description}</p>

            {metric && (
              <p class="proj-stat">
                <span class="proj-stat-number">−{metric.replace('%', '')}<span class="proj-stat-unit">%</span></span>
                <span class="proj-stat-label">tempo de processamento, mantendo a detecção</span>
              </p>
            )}

            {isTalks && (
              <ul class="proj-events">
                {speaking.map((s) => (
                  <li>
                    <Icon name="calendar" size={16} />
                    <span>
                      <strong>{s.event}</strong> — {s.host}
                      <span class="proj-event-date"> · {formatYearMonth(s.date)}</span>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {p.contributors.length > 0 && (
              <p class="proj-people">com {p.contributors.join(' · ')}</p>
            )}

            <ul class="proj-skills" aria-label="Competências do projeto">
              {p.skills.map((s) => (
                <li><Tag>{s}</Tag></li>
              ))}
            </ul>

            {related.length > 0 && (
              <ul class="proj-links">
                {related.map((pub) => (
                  <li>
                    <a href={pub.permalink} target="_blank" rel="noopener noreferrer">
                      <Icon name="external-link" size={15} />
                      Publicação no LinkedIn · {formatIsoDate(pub.date)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </Card>
        );
      })}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .projects :global(.card) {
    background: var(--bg);
  }

  /* Destaque: o projeto autoral com página própria (/omni-pentest). */
  .proj-featured {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    color: inherit;
    transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .proj-featured:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    /* O card inteiro é um link: o sublinhado global de `a:hover` riscaria o
       cartão todo. A afordância aqui é a borda + a seta que anda. */
    text-decoration: none;
  }
  .pf-media {
    inline-size: 72px;
    block-size: 72px;
    overflow: hidden;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .pf-logo {
    display: block;
    width: 100%;
    height: 100%;
    /* a arte já é quadrada — `cover` só garante que nunca sobre faixa vazia */
    object-fit: cover;
  }
  .pf-body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .pf-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .pf-version {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .pf-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .pf-desc {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .pf-desc b {
    color: var(--text);
    font-weight: 600;
  }
  .pf-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pf-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .proj-featured:hover .pf-cta :global(svg) {
    translate: 3px 0;
  }
  .pf-cta :global(svg) {
    transition: translate var(--dur-2) var(--ease);
  }
  @media (max-width: 640px) {
    .proj-featured {
      grid-template-columns: 1fr;
      padding: var(--space-5);
    }
  }

  .proj-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  @media (max-width: 900px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }

  /* v2: mais respiro dentro dos cards ("tudo muito junto") */
  .projects :global(.proj-card) {
    padding: var(--space-6);
  }
  .proj-grid :global(.proj-card) {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
  }
  .proj-grid :global(.proj-card) h3 {
    line-height: 1.3;
  }
  .proj-desc {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }

  .proj-stat {
    display: grid;
    gap: 2px;
    padding: var(--space-4);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-md);
    background: var(--accent-soft);
  }
  .proj-stat-number {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .proj-stat-unit {
    font-size: 1.4rem;
  }
  .proj-stat-label {
    font-size: var(--fs-xs);
    color: var(--text-2);
  }

  .proj-events {
    display: grid;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .proj-events li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  .proj-events :global(svg) {
    color: var(--text-3);
    flex: none;
    translate: 0 2px;
  }
  .proj-event-date {
    color: var(--text-3);
  }

  .proj-people {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .proj-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .proj-links {
    display: grid;
    gap: var(--space-2);
  }
  .proj-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: 500;
  }
</style>
